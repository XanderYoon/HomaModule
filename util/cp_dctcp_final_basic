#!/usr/bin/python3

from cperf import *


def avg(values, fmt):
    result = fmt % (sum(values) / float(len(values)))
    result += " ("
    for value in values:
        if result[-1] != "(":
            result += " "
        result += fmt % (value)
    result += ")"
    return result


def maybe_metric(experiments, exp_name, field, transform=None, fmt="%.2f"):
    if exp_name not in experiments:
        return "n/a"
    node = experiments[exp_name].get("node-0", {})
    if field not in node or len(node[field]) == 0:
        return "n/a"
    values = node[field]
    if transform:
        values = [transform(value) for value in values]
    return avg(values, fmt)


VARIANTS = [
    {
        "name": "dctcp",
        "label": "DCTCP",
        "tcp_fastopen": False,
        "tcp_client_pooling": False,
        "tcp_multiplex": False,
        "tcp_multiplex_sessions": 1,
        "tcp_pool_size": 1,
        "tcp_load_aware": False,
        "tcp_stagger_us": 0,
    },
]


def parse_offset_us(value):
    try:
        offset_us = int(value)
    except ValueError:
        raise Error("Illegal value for --offset-us: %s" % (value))
    if offset_us < 0:
        raise Error("--offset-us must be non-negative: %s" % (value))
    return offset_us


def get_variants(offset_us):
    variants = copy.deepcopy(VARIANTS)
    variants.append({
        "name": "dctcp_static",
        "label": "DCTCP + Static Scheduler (%d us)" % (
                offset_us),
        "tcp_fastopen": False,
        "tcp_client_pooling": False,
        "tcp_multiplex": False,
        "tcp_multiplex_sessions": 1,
        "tcp_pool_size": 1,
        "tcp_load_aware": False,
        "tcp_stagger_us": offset_us,
    })
    return variants


def apply_variant_options(options, variant):
    configured = copy.deepcopy(options)
    for key, value in variant.items():
        if key in ("name", "label"):
            continue
        setattr(configured, key, value)
    return configured


def configure_variant_environment(options, all_nodes):
    set_sysctl_parameter("net.ipv4.tcp_congestion_control", "dctcp",
            all_nodes)
    set_sysctl_parameter("net.ipv4.tcp_ecn", "1", all_nodes)
    set_sysctl_parameter("net.ipv4.tcp_fastopen",
            "3" if getattr(options, "tcp_fastopen", False) else "0",
            all_nodes)


def run_homa_suite(options):
    start_servers(range(1, options.num_nodes), options)
    o = copy.deepcopy(options)
    o.client_ports = 1
    o.port_receivers = 0
    o.client_max = 1
    o.server_nodes = 1
    o.first_server = 1
    o.server_ports = 1
    o.workload = "100"
    o.num_servers = 1
    run_experiment("homa_latency", range(0, 1), o)

    o.workload = "500000"
    run_experiment("homa_1msg_tput", range(0, 1), o)

    o = copy.deepcopy(options)
    o.workload = "100"
    o.server_nodes = options.num_nodes - 1
    o.first_server = 1
    run_experiment("homa_client_rpc_tput", range(0, 1), o)

    o.workload = "500000"
    o.client_max = 50
    run_experiment("homa_client_tput", range(0, 1), o)

    start_servers(range(0, 1), options)
    o = copy.deepcopy(options)
    o.workload = "100"
    o.server_nodes = 1
    o.first_server = 0
    o.client_max = 10
    run_experiment("homa_server_rpc_tput", range(1, options.num_nodes), o)

    o.workload = "500000"
    o.client_max = 5
    run_experiment("homa_server_tput", range(1, options.num_nodes), o)


def run_tcp_suite(options, variant):
    all_nodes = range(0, options.num_nodes)
    tcp_options = apply_variant_options(options, variant)
    tcp_options.protocol = "tcp"
    configure_variant_environment(tcp_options, all_nodes)
    prefix = variant["name"]

    start_servers(range(1, options.num_nodes), tcp_options)
    o = copy.deepcopy(tcp_options)
    o.tcp_client_ports = 1
    o.client_max = 1
    o.server_nodes = 1
    o.first_server = 1
    o.tcp_server_ports = 1
    o.workload = "100"
    o.num_servers = 1
    run_experiment("%s_latency" % (prefix), range(0, 1), o)

    o.workload = "500000"
    run_experiment("%s_1msg_tput" % (prefix), range(0, 1), o)

    o = copy.deepcopy(tcp_options)
    o.workload = "100"
    o.server_nodes = options.num_nodes - 1
    o.first_server = 1
    o.client_max = 100
    run_experiment("%s_client_rpc_tput" % (prefix), range(0, 1), o)

    o.workload = "500000"
    o.client_max = 20
    run_experiment("%s_client_tput" % (prefix), range(0, 1), o)

    start_servers(range(0, 1), tcp_options)
    o = copy.deepcopy(tcp_options)
    o.workload = "100"
    o.server_nodes = 1
    o.first_server = 0
    o.client_max = 50
    run_experiment("%s_server_rpc_tput" % (prefix),
            range(1, options.num_nodes), o)

    o.workload = "500000"
    o.client_max = 5
    run_experiment("%s_server_tput" % (prefix),
            range(1, options.num_nodes), o)


parser = get_parser(description=
        'Measures cp_basic-style latency and throughput for Homa, baseline '
        'DCTCP, and DCTCP with application-layer static scheduling.',
        usage='%(prog)s [options]',
        defaults={
            "client_ports":     9,
            "port_receivers":   1,
            "server_ports":     6,
            "port_threads":     3,
            "tcp_client_ports": 9,
            "tcp_server_ports": 16})
parser.add_argument('--offset-us', dest='offset_us', metavar='offset',
        default="5",
        help="Static scheduler offset in microseconds for the combined "
        "DCTCP static-scheduler variant (default: 5)")
parser.add_argument('--dctcp-netem-loss', dest='dctcp_netem_loss',
        default="", help="Optional tc netem loss to apply during DCTCP "
        "variant runs, such as '0.5%%' (default: none)")
options = parser.parse_args()
options.no_rtt_files = True
offset_us = parse_offset_us(options.offset_us)
VARIANTS = get_variants(offset_us)
init(options)
if options.num_nodes < 2:
    print("--num_nodes too small (%d): must be at least 2"
            % (options.num_nodes))
    sys.exit(-1)

congestion = get_sysctl_parameter("net.ipv4.tcp_congestion_control")
tcp_fastopen = get_sysctl_parameter("net.ipv4.tcp_fastopen")
tcp_ecn = get_sysctl_parameter("net.ipv4.tcp_ecn")

if not options.plot_only:
    all_nodes = list(range(0, options.num_nodes))
    run_homa_suite(options)
    for variant in VARIANTS:
        try:
            if options.dctcp_netem_loss != "":
                set_netem_loss(all_nodes, options.dctcp_netem_loss)
            run_tcp_suite(options, variant)
        finally:
            if options.dctcp_netem_loss != "":
                clear_netem_loss(all_nodes)

    set_sysctl_parameter("net.ipv4.tcp_congestion_control", congestion,
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_fastopen", tcp_fastopen,
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_ecn", tcp_ecn,
            range(0, options.num_nodes))
    log("Stopping nodes")
    stop_nodes()

experiments = {}
scan_log(options.log_dir + "/node-0.log", "node-0", experiments)

log("Homa RTT latency (us): %s" % (
        maybe_metric(experiments, "homa_latency", "client_latency",
        fmt="%.2f")))
log("Homa single message throughput (Gbps): %s" % (
        maybe_metric(experiments, "homa_1msg_tput", "client_gbps",
        transform=lambda value: 2 * value, fmt="%.2f")))
log("Homa client RPC throughput (Kops/sec): %s" % (
        maybe_metric(experiments, "homa_client_rpc_tput", "client_kops",
        fmt="%.2f")))
log("Homa server RPC throughput (Kops/sec): %s" % (
        maybe_metric(experiments, "homa_server_rpc_tput", "server_kops",
        fmt="%.2f")))
log("Homa client throughput (Gbps): %s" % (
        maybe_metric(experiments, "homa_client_tput", "client_gbps",
        fmt="%.2f")))
log("Homa server throughput (Gbps): %s" % (
        maybe_metric(experiments, "homa_server_tput", "server_gbps",
        fmt="%.2f")))

for variant in VARIANTS:
    prefix = variant["name"]
    label = variant["label"]
    log("\n%s RTT latency (us): %s" % (
            label, maybe_metric(experiments, "%s_latency" % (prefix),
            "client_latency", fmt="%.2f")))
    log("%s single message throughput (Gbps): %s" % (
            label, maybe_metric(experiments, "%s_1msg_tput" % (prefix),
            "client_gbps", transform=lambda value: 2 * value, fmt="%.2f")))
    log("%s client RPC throughput (Kops/sec): %s" % (
            label, maybe_metric(experiments, "%s_client_rpc_tput" % (prefix),
            "client_kops", fmt="%.2f")))
    log("%s server RPC throughput (Kops/sec): %s" % (
            label, maybe_metric(experiments, "%s_server_rpc_tput" % (prefix),
            "server_kops", fmt="%.2f")))
    log("%s client throughput (Gbps): %s" % (
            label, maybe_metric(experiments, "%s_client_tput" % (prefix),
            "client_gbps", fmt="%.2f")))
    log("%s server throughput (Gbps): %s" % (
            label, maybe_metric(experiments, "%s_server_tput" % (prefix),
            "server_gbps", fmt="%.2f")))
