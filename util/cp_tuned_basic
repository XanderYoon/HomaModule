#!/usr/bin/python3

from cperf import *


def avg(values, fmt):
    result = fmt % (sum(values) / float(len(values)))
    result += " ("
    for value in values:
        if result[-1] != "(":
            result += " "
        result += fmt % (value)
    result += ")"
    return result


def apply_tuned_dctcp_options(options):
    configured = copy.deepcopy(options)
    configured.protocol = "tcp"
    configured.tcp_client_pooling = True
    configured.tcp_http2 = True
    configured.tcp_http2_sessions = options.http2_sessions
    configured.tcp_pool_size = options.pool_size
    configured.tcp_fastopen = options.tfo
    return configured


def configure_tuned_dctcp_environment(options):
    set_sysctl_parameter("net.ipv4.tcp_congestion_control", "dctcp",
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_ecn", "1",
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_fastopen",
            "3" if options.tfo else "0", range(0, options.num_nodes))


def tuned_label(options):
    parts = [
        "Tuned DCTCP",
        "HTTP/2 sessions=%d" % (options.http2_sessions),
        "pool=%d" % (options.pool_size),
    ]
    if options.tfo:
        parts.append("TFO")
    return ", ".join(parts)


parser = get_parser(description=
        'Measures cp_basic-style latency and throughput for Homa versus '
        'a tuned DCTCP configuration using HTTP/2 sessions and connection '
        'pooling.',
        usage='%(prog)s [options]',
        defaults={
            "client_ports":     9,
            "port_receivers":   1,
            "server_ports":     6,
            "port_threads":     3,
            "tcp_client_ports": 9,
            "tcp_server_ports": 16,
            "tcp_http2_sessions": 1,
            "tcp_client_pooling": True,
            "tcp_pool_size":     1})
parser.add_argument('--tfo', dest='tfo', type=boolean, default=False,
        help="Boolean value: whether to enable TCP Fast Open for tuned DCTCP "
                "(default: false)")
parser.add_argument('--http2-sessions', dest='http2_sessions', type=int,
        default=4, metavar='count',
        help="Number of HTTP/2 sessions to use in the tuned DCTCP variant "
                "(default: 4)")
parser.add_argument('--pool-size', dest='pool_size', type=int, default=1,
        metavar='count',
        help="TCP connection pool size to use in the tuned DCTCP variant "
                "(default: 1)")
options = parser.parse_args()
options.no_rtt_files = True
init(options)
if options.num_nodes < 2:
    print("--num_nodes too small (%d): must be at least 2"
            % (options.num_nodes))
    sys.exit(-1)
if options.http2_sessions < 1:
    print("--http2-sessions must be at least 1")
    sys.exit(-1)
if options.pool_size < 1:
    print("--pool-size must be at least 1")
    sys.exit(-1)

congestion = get_sysctl_parameter("net.ipv4.tcp_congestion_control")
tcp_fastopen = get_sysctl_parameter("net.ipv4.tcp_fastopen")
tcp_ecn = get_sysctl_parameter("net.ipv4.tcp_ecn")

if not options.plot_only:
    start_servers(range(1, options.num_nodes), options)
    o = copy.deepcopy(options)
    o.client_ports = 1
    o.port_receivers = 0
    o.client_max = 1
    o.server_nodes = 1
    o.first_server = 1
    o.server_ports = 1
    o.workload = "100"
    o.num_servers = 1
    o.first_server = 1
    run_experiment("homa_latency", range(0, 1), o)

    o.workload = "500000"
    run_experiment("homa_1msg_tput", range(0, 1), o)

    o = copy.deepcopy(options)
    o.workload = "500000"
    o.server_nodes = options.num_nodes-1
    o.first_server = 1
    o.client_max = 50
    run_experiment("homa_client_tput", range(0, 1), o)

    start_servers(range(0, 1), options)
    o = copy.deepcopy(options)
    o.workload = "500000"
    o.server_nodes = 1
    o.first_server = 0
    o.client_max = 5
    run_experiment("homa_server_tput", range(1, options.num_nodes), o)

    configure_tuned_dctcp_environment(options)
    tcp_options = apply_tuned_dctcp_options(options)

    start_servers(range(1, options.num_nodes), tcp_options)
    o = copy.deepcopy(tcp_options)
    o.tcp_client_ports = 1
    o.client_max = 1
    o.server_nodes = 1
    o.first_server = 1
    o.tcp_server_ports = 1
    o.workload = "100"
    o.num_servers = 1
    run_experiment("tuned_dctcp_latency", range(0, 1), o)

    o.workload = "500000"
    run_experiment("tuned_dctcp_1msg_tput", range(0, 1), o)

    o = copy.deepcopy(tcp_options)
    o.workload = "500000"
    o.server_nodes = options.num_nodes-1
    o.first_server = 1
    o.client_max = 20
    run_experiment("tuned_dctcp_client_tput", range(0, 1), o)

    start_servers(range(0, 1), tcp_options)
    o = copy.deepcopy(tcp_options)
    o.workload = "500000"
    o.server_nodes = 1
    o.first_server = 0
    o.client_max = 5
    run_experiment("tuned_dctcp_server_tput", range(1, options.num_nodes), o)

    set_sysctl_parameter("net.ipv4.tcp_congestion_control", congestion,
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_fastopen", tcp_fastopen,
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_ecn", tcp_ecn, range(0, options.num_nodes))
    log("Stopping nodes")
    stop_nodes()

experiments = {}
scan_log(options.log_dir + "/node-0.log", "node-0", experiments)

node = experiments["homa_latency"]["node-0"]
if len(node["client_latency"]) == 0:
    raise Error("No Homa client latencies found")
log("Homa RTT latency (us): %s" % (avg(node["client_latency"], "%.2f")))

node = experiments["homa_1msg_tput"]["node-0"]
if len(node["client_gbps"]) == 0:
    raise Error("No Homa client throughput found")
gbps = []
for m in node["client_gbps"]:
    gbps.append(2*m)
log("Homa single message throughput (Gbps): %s" % (avg(gbps, "%.1f")))

node = experiments["homa_client_tput"]["node-0"]
if len(node["client_gbps"]) == 0:
    raise Error("No Homa client throughputs found")
log("Homa client throughput (Gbps): %s"
        % (avg(node["client_gbps"], "%.2f")))

node = experiments["homa_server_tput"]["node-0"]
if len(node["server_gbps"]) == 0:
    raise Error("No Homa server throughputs found")
log("Homa server throughput (Gbps): %s"
        % (avg(node["server_gbps"], "%.2f")))

name = tuned_label(options)
node = experiments["tuned_dctcp_latency"]["node-0"]
if len(node["client_latency"]) == 0:
    raise Error("No %s client latencies found" % (name))
log("\n%s RTT latency (us): %s" % (name, avg(node["client_latency"], "%.2f")))

node = experiments["tuned_dctcp_1msg_tput"]["node-0"]
if len(node["client_gbps"]) == 0:
    raise Error("No %s client throughput found" % (name))
gbps = []
for m in node["client_gbps"]:
    gbps.append(2*m)
log("%s single message throughput (Gbps): %s"
        % (name, avg(gbps, "%.2f")))

node = experiments["tuned_dctcp_client_tput"]["node-0"]
if len(node["client_gbps"]) == 0:
    raise Error("No %s client throughputs found" % (name))
log("%s client throughput (Gbps): %s"
        % (name, avg(node["client_gbps"], "%.2f")))

node = experiments["tuned_dctcp_server_tput"]["node-0"]
if len(node["server_gbps"]) == 0:
    raise Error("No %s server throughputs found" % (name))
log("%s server throughput (Gbps): %s"
        % (name, avg(node["server_gbps"], "%.2f")))
