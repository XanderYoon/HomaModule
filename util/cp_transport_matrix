#!/usr/bin/python3

from cperf import *


def avg(values, fmt):
    result = fmt % (sum(values)/float(len(values)))
    result += " ("
    for value in values:
        if result[-1] != "(":
            result += " "
        result += fmt % (value)
    result += ")"
    return result


def parse_int_list(value, option_name, allow_zero=False):
    try:
        values = [int(part.strip()) for part in value.split(",") if part.strip()]
    except ValueError:
        raise Error("Illegal value for %s: %s" % (option_name, value))
    if len(values) == 0:
        raise Error("%s must contain at least one integer" % (option_name))
    for item in values:
        if allow_zero:
            if item < 0:
                raise Error("%s values must be non-negative: %s"
                        % (option_name, value))
        else:
            if item <= 0:
                raise Error("%s values must be positive: %s"
                        % (option_name, value))
    return values


def maybe_metric(experiments, exp_name, field, transform=None, fmt="%.2f"):
    if exp_name not in experiments:
        return "n/a"
    node = experiments[exp_name].get("node-0", {})
    if field not in node or len(node[field]) == 0:
        return "n/a"
    values = node[field]
    if transform:
        values = [transform(v) for v in values]
    return avg(values, fmt)


def dctcp_variant(name, label, **kwargs):
    variant = {
        "name": name,
        "label": label,
        "protocol": "dctcp",
        "tcp_fastopen": False,
        "tcp_http2": False,
        "tcp_http2_sessions": 1,
        "tcp_client_pooling": False,
        "tcp_pool_size": 1,
    }
    variant.update(kwargs)
    return variant


def make_variants(options):
    variants = [
        {
            "name": "tcp",
            "label": "TCP",
            "protocol": "tcp",
        },
        dctcp_variant("dctcp", "DCTCP"),
    ]
    if options.include_tfo:
        variants.append(dctcp_variant("dctcp_tfo", "DCTCP + TFO",
                tcp_fastopen=True, client_max=32))
    for pool_size in options.pool_sizes:
        variants.append(dctcp_variant("dctcp_pool_p%d" % (pool_size),
                "DCTCP + Pool %d" % (pool_size),
                tcp_client_pooling=True, tcp_pool_size=pool_size))
    for session_count in options.http2_session_counts:
        variants.append(dctcp_variant("dctcp_http2_s%d" % (session_count),
                "DCTCP + HTTP/2 x%d" % (session_count),
                tcp_client_pooling=True, tcp_http2=True,
                tcp_http2_sessions=session_count))
    for offset_us in options.offsets_us:
        variants.append(dctcp_variant("dctcp_static_o%d" % (offset_us),
                "DCTCP + Offset %dus" % (offset_us),
                tcp_stagger_us=offset_us))
    if options.include_load_aware:
        variants.append(dctcp_variant("dctcp_load_aware",
                "DCTCP + Load-Aware", tcp_load_aware=True))
    return variants


def apply_variant_options(options, variant):
    configured = copy.deepcopy(options)
    for key, value in variant.items():
        if key in ("name", "label", "protocol"):
            continue
        setattr(configured, key, value)
    return configured


def configure_variant_environment(options, variant, all_nodes):
    protocol = variant["protocol"]
    if protocol == "tcp":
        set_sysctl_parameter("net.ipv4.tcp_congestion_control", "cubic",
                all_nodes)
        set_sysctl_parameter("net.ipv4.tcp_ecn", "0", all_nodes)
    else:
        set_sysctl_parameter("net.ipv4.tcp_congestion_control", "dctcp",
                all_nodes)
        set_sysctl_parameter("net.ipv4.tcp_ecn", "1", all_nodes)
    set_sysctl_parameter("net.ipv4.tcp_fastopen",
            "3" if getattr(options, "tcp_fastopen", False) else "0",
            all_nodes)


def run_homa_suite(options):
    start_servers(range(1, options.num_nodes), options)
    o = copy.deepcopy(options)
    o.client_ports = 1
    o.port_receivers = 0
    o.client_max = 1
    o.server_nodes = 1
    o.first_server = 1
    o.server_ports = 1
    o.workload = "100"
    o.num_servers = 1
    run_experiment("homa_latency", range(0, 1), o)

    o.workload = "500000"
    run_experiment("homa_1msg_tput", range(0, 1), o)

    o = copy.deepcopy(options)
    o.workload = "100"
    o.server_nodes = options.num_nodes-1
    o.first_server = 1
    run_experiment("homa_client_rpc_tput", range(0, 1), o)

    o.workload = "500000"
    o.client_max = 50
    run_experiment("homa_client_tput", range(0, 1), o)

    start_servers(range(0, 1), options)
    o = copy.deepcopy(options)
    o.workload = "100"
    o.server_nodes = 1
    o.first_server = 0
    o.client_max = 10
    run_experiment("homa_server_rpc_tput", range(1, options.num_nodes), o)

    o.workload = "500000"
    o.client_max = 5
    run_experiment("homa_server_tput", range(1, options.num_nodes), o)


def run_tcp_like_suite(options, variant):
    all_nodes = range(0, options.num_nodes)
    configured = apply_variant_options(options, variant)
    configured.protocol = "tcp"
    configure_variant_environment(configured, variant, all_nodes)
    prefix = variant["name"]

    start_servers(range(1, options.num_nodes), configured)
    o = copy.deepcopy(configured)
    o.tcp_client_ports = 1
    o.client_max = 1
    o.server_nodes = 1
    o.first_server = 1
    o.tcp_server_ports = 1
    o.workload = "100"
    o.num_servers = 1
    run_experiment("%s_latency" % (prefix), range(0, 1), o)

    o.workload = "500000"
    run_experiment("%s_1msg_tput" % (prefix), range(0, 1), o)

    o = copy.deepcopy(configured)
    o.workload = "100"
    o.server_nodes = options.num_nodes-1
    o.first_server = 1
    o.client_max = 100
    run_experiment("%s_client_rpc_tput" % (prefix), range(0, 1), o)

    o.workload = "500000"
    o.client_max = 20
    run_experiment("%s_client_tput" % (prefix), range(0, 1), o)

    start_servers(range(0, 1), configured)
    o = copy.deepcopy(configured)
    o.workload = "100"
    o.server_nodes = 1
    o.first_server = 0
    o.client_max = 50
    run_experiment("%s_server_rpc_tput" % (prefix),
            range(1, options.num_nodes), o)

    o.workload = "500000"
    o.client_max = 5
    run_experiment("%s_server_tput" % (prefix),
            range(1, options.num_nodes), o)


parser = get_parser(description=
        'Measures Table 2 style metrics for Homa, TCP, DCTCP, and tunable '
        'transport variants such as TFO, connection pooling, HTTP/2-style '
        'multiplexing, static offsets, and load-aware balancing.',
        usage='%(prog)s [options]',
        defaults={
            "client_ports":     9,
            "port_receivers":   1,
            "server_ports":     6,
            "port_threads":     3,
            "tcp_client_ports": 9,
            "tcp_server_ports": 16})
parser.add_argument('-n', '--nodes', type=int, dest='num_nodes',
        metavar='N', default=5,
        help='Total number of nodes to use in the cluster (default: 5)')
parser.add_argument('--http2-session-counts', dest='http2_session_counts',
        metavar='counts', default="1,2,4,8",
        help="Comma-separated HTTP/2 multiplexed session counts to compare "
        "(default: 1,2,4,8)")
parser.add_argument('--pool-sizes', dest='pool_sizes', metavar='counts',
        default="1,4,8,16",
        help="Comma-separated connection pool sizes to compare "
        "(default: 1,4,8,16)")
parser.add_argument('--offsets-us', dest='offsets_us', metavar='offsets',
        default="0,5,10,25,50",
        help="Comma-separated static scheduler offsets in microseconds "
        "(default: 0,5,10,25,50)")
parser.add_argument('--include-tfo', dest='include_tfo', type=boolean,
        default=True, help="Boolean value: whether to include the DCTCP + "
        "TFO variant (default: true)")
parser.add_argument('--include-load-aware', dest='include_load_aware',
        type=boolean, default=True, help="Boolean value: whether to include "
        "the DCTCP + load-aware variant (default: true)")
options = parser.parse_args()
options.no_rtt_files = True
options.http2_session_counts = parse_int_list(options.http2_session_counts,
        "--http2-session-counts")
options.pool_sizes = parse_int_list(options.pool_sizes, "--pool-sizes")
options.offsets_us = parse_int_list(options.offsets_us, "--offsets-us",
        allow_zero=True)
VARIANTS = make_variants(options)
init(options)
if options.num_nodes < 2:
    print("--num_nodes too small (%d): must be at least 2"
            % (options.num_nodes))
    sys.exit(-1)

congestion = get_sysctl_parameter("net.ipv4.tcp_congestion_control")
tcp_fastopen = get_sysctl_parameter("net.ipv4.tcp_fastopen")
tcp_ecn = get_sysctl_parameter("net.ipv4.tcp_ecn")

if not options.plot_only:
    run_homa_suite(options)
    for variant in VARIANTS:
        run_tcp_like_suite(options, variant)

    set_sysctl_parameter("net.ipv4.tcp_congestion_control", congestion,
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_fastopen", tcp_fastopen,
            range(0, options.num_nodes))
    set_sysctl_parameter("net.ipv4.tcp_ecn", tcp_ecn,
            range(0, options.num_nodes))
    log("Stopping nodes")
    stop_nodes()

experiments = {}
scan_log(options.log_dir + "/node-0.log", "node-0", experiments)

node = experiments["homa_latency"]["node-0"]
log("Homa RTT latency (us): %s" % (avg(node["client_latency"], "%.2f")))
node = experiments["homa_1msg_tput"]["node-0"]
log("Homa single message throughput (Gbps): %s"
        % (avg([2*m for m in node["client_gbps"]], "%.1f")))
node = experiments["homa_client_rpc_tput"]["node-0"]
log("Homa client RPC throughput (Kops/sec): %s"
        % (avg(node["client_kops"], "%.2f")))
node = experiments["homa_server_rpc_tput"]["node-0"]
log("Homa server RPC throughput (Kops/sec): %s"
        % (avg(node["server_kops"], "%.2f")))
node = experiments["homa_client_tput"]["node-0"]
log("Homa client throughput (Gbps): %s"
        % (avg(node["client_gbps"], "%.2f")))
node = experiments["homa_server_tput"]["node-0"]
log("Homa server throughput (Gbps): %s"
        % (avg(node["server_gbps"], "%.2f")))

for variant in VARIANTS:
    prefix = variant["name"]
    label = variant["label"]
    log("\n%s RTT latency (us): %s" % (
            label, maybe_metric(experiments, "%s_latency" % prefix,
            "client_latency", fmt="%.2f")))
    log("%s single message throughput (Gbps): %s" % (
            label, maybe_metric(experiments, "%s_1msg_tput" % prefix,
            "client_gbps", transform=lambda v: 2*v, fmt="%.2f")))
    log("%s client RPC throughput (Kops/sec): %s" % (
            label, maybe_metric(experiments, "%s_client_rpc_tput" % prefix,
            "client_kops", fmt="%.2f")))
    log("%s server RPC throughput (Kops/sec): %s" % (
            label, maybe_metric(experiments, "%s_server_rpc_tput" % prefix,
            "server_kops", fmt="%.2f")))
    log("%s client throughput (Gbps): %s" % (
            label, maybe_metric(experiments, "%s_client_tput" % prefix,
            "client_gbps", fmt="%.2f")))
    log("%s server throughput (Gbps): %s" % (
            label, maybe_metric(experiments, "%s_server_tput" % prefix,
            "server_gbps", fmt="%.2f")))
